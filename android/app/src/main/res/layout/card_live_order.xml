<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_order_card">

    <!-- Header row -->
    <LinearLayout
        android:id="@+id/orderCardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@drawable/bg_order_header">

        <ImageView
            android:id="@+id/icOrderStatus"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_car"/>

        <TextView
            android:id="@+id/tvOrderStatusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="新訂單"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btnDismissOrder"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_close"
            android:alpha="0.4"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Chips row: fare / trip distance / pickup distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFareChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HK$--"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_yellow"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"/>

            <TextView
                android:id="@+id/tvTripDistChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="-- km"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_cyan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvPickupDistChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="接客 -- km"
                android:textColor="@color/accent_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_orange"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Fare per km -->
        <TextView
            android:id="@+id/tvFarePerKm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="HK$--/km"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:visibility="gone"/>

        <!-- Pickup address -->
        <LinearLayout
            android:id="@+id/pickupRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_origin"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="接客"
                    android:textColor="@color/text_disabled"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Destination address -->
        <LinearLayout
            android:id="@+id/destinationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_destination"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目的地"
                    android:textColor="@color/text_disabled"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvDestAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- View raw log (visible in debug mode) -->
        <TextView
            android:id="@+id/btnViewLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="查看原始Log ›"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>
