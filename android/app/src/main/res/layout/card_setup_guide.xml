<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:padding="16dp"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lightbulb"
            android:colorFilter="@color/accent_yellow"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="使用步驟"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="1" android:gravity="center" android:textColor="@color/accent_blue"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_step_circle"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="點「開啟」進入無障礙設定"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="2" android:gravity="center" android:textColor="@color/accent_blue"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_step_circle"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="找「搶單助手」並開啟服務"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="3" android:gravity="center" android:textColor="@color/accent_blue"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_step_circle"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="返回本App，狀態顯示「監控中」"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="4" android:gravity="center" android:textColor="@color/accent_blue"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_step_circle"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="設定右上角「⚙」搶單規則（車費、距離等）"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="5" android:gravity="center" android:textColor="@color/accent_blue"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_step_circle"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="開啟高德司機App，彈單時自動搶單！"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

</LinearLayout>
