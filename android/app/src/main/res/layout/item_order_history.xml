<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="6dp"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Status icon -->
    <FrameLayout
        android:id="@+id/statusIconBg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_status_circle_green">

        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_flash"/>
    </FrameLayout>

    <!-- Order info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HK$--"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvHistTripDist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvHistTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_disabled"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistPickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvHistResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="自動接單"
            android:textColor="@color/accent_green"
            android:textSize="11sp"/>
    </LinearLayout>

</LinearLayout>
